# PanenDesa Root Environment Variables
# This file is used by docker-compose.yml for deployment

# Port Configuration
# Host ports (exposed to server/Cloudflare Tunnel)
BACKEND_PORT=3011
FRONTEND_PORT=3010

# Backend Environment Variables (Runtime)
# These are passed to the backend container via docker-compose
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET=your_jwt_secret_here
INTERNAL_SERVICE_KEY=your_internal_service_key_here

# Frontend Build Arguments (Baked at build time)
# These MUST be set at build time because Next.js inlines them to client bundle
NEXT_PUBLIC_API_URL=http://localhost:3011
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
